MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
CLIENT_URL=https://your-vercel-app.vercel.app
PORT=5000

# AI assistant (Groq). Without a key chat answers 503 (not configured).
GROQ_API_KEY=your_groq_api_key
# Optional; defaults to openai/gpt-oss-120b.
# GROQ_MODEL=openai/gpt-oss-120b

# Proxy hops to trust for the client IP the rate limiters key on: false, a hop
# count, true, or an address/subnet list Express accepts. Unset = 1 in
# production, off elsewhere. Confirm the right value behind your host.
# TRUST_PROXY=1

# Assistant cost and latency bounds (all optional; these are the defaults).
# Each must be a whole number above 0; anything else is ignored with a warning.
# Most tokens one reply may generate (gpt-oss's hidden reasoning counts too).
# CHAT_MAX_TOKENS=2048
# Deadline for the whole Groq call, in ms; slower answers get a 504.
# CHAT_TIMEOUT_MS=20000
# Messages per user per UTC day. Counted in memory: a restart resets it.
# CHAT_DAILY_LIMIT=50

# Password reset (H-06). OFF unless all three agree: the switch is "true", the
# transport delivers email, and CLIENT_URL (above) is the client's origin, which
# the emailed link points at (https in production; outside production it
# defaults to http://localhost:5173). The server logs one line at start-up
# saying whether reset is on and, if not, why.
# PASSWORD_RESET_ENABLED=false
# How email is sent: none (default, sends nothing, so reset stays off) or
# console (prints the email, link included, to this log: development only,
# refused in production). No real provider is wired up yet; see
# server/utils/mailer.js for where one plugs in.
# EMAIL_TRANSPORT=none
